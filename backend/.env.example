# Environment Configuration
APP_ENV=development
APP_PORT=8080
APP_HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=cso_erp
DB_SSLMODE=disable

# JWT Configuration
# Use a strong, random secret in production (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Short expiry for better security (3 hours default)
JWT_EXPIRY=3h
JWT_REFRESH_EXPIRY=168h

# =====================================================
# Security Configuration
# =====================================================

# AES-256-GCM Encryption Key (REQUIRED for production)
# Generate with: openssl rand -hex 32
# This 64-character hex string represents a 32-byte key
# WARNING: Back up this key securely! Losing it means losing encrypted data
ENCRYPTION_KEY=

# Argon2id Password Hashing Parameters (OWASP recommended)
# Memory in KB (65536 = 64MB, provides strong GPU attack resistance)
ARGON2_MEMORY=65536
# Iterations (time cost)
ARGON2_ITERATIONS=3
# CPU parallelism (threads)
ARGON2_PARALLELISM=4

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# =====================================================
# CORS Configuration
# =====================================================
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# =====================================================
# File Upload Configuration
# =====================================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# =====================================================
# Email / SMTP Configuration (for 2FA)
# =====================================================
# Leave empty to use mock mode (emails logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@lco.org.ly
SMTP_FROM_NAME=CSO ERP System
SMTP_USE_TLS=true
# Set to true only in development with self-signed certs
SMTP_SKIP_VERIFY=false

# =====================================================
# Multi-Tenant Configuration (Super System Admin)
# =====================================================
# Master database for organization management
MASTER_DB_NAME=erp_master
# Template database for cloning tenant schemas
TENANT_DB_TEMPLATE=cso-erp
# Prefix for tenant database names (optional)
TENANT_DB_PREFIX=

# SSA Access Control (comma-separated IPs)
# Only these IPs can access the Super System Admin panel
ALLOWED_SSA_IPS=127.0.0.1,::1

# Verification Settings
VERIFICATION_CODE_EXPIRY=5m
MAX_VERIFICATION_ATTEMPTS=3

# Billing Feature Toggle (set to true when ready)
BILLING_ENABLED=false

# =====================================================
# IMPORTANT SECURITY NOTES
# =====================================================
# 1. EMAIL DOMAIN RESTRICTION: Only @lco.org.ly emails are allowed
# 2. ALL COOKIES: Set with HttpOnly, Secure, SameSite=Strict
# 3. PASSWORDS: Hashed with Argon2id (64MB memory, 3 iterations)
# 4. AUDIT LOGS: Tamper-proof with blockchain-style chaining
# 5. KILL SWITCH: Revoke all sessions via token versioning
# 6. TWO-FACTOR AUTH: Email-based OTP with 10-minute expiry
# 7. SSA ACCESS: Protected by IP whitelist + 2FA + role check
